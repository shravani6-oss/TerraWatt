# Copy to .env  (never commit the real file)
TERRAWATT_ENV=development          # development | production
SECRET_KEY=                        # REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
                                   # in development a key is generated and stored in instance/.secret_key
DATABASE_PATH=instance/terrawatt.db
JWT_TTL_HOURS=12
COOKIE_SECURE=false                # defaults to true in production (needs HTTPS)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
ADMIN_EMAIL=                       # optional: seeds an admin account on first start
ADMIN_PASSWORD=
LOG_LEVEL=INFO
PORT=5000
